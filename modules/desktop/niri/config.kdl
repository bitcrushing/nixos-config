// niri config. Keybindings are in binds.kdl. Colours, gaps, border width,
// cursor and anything needing a Nix store path are in nix.kdl, generated by
// modules/desktop/niri.nix. The wallpaper (swaybg) is a systemd user service
// from modules/desktop/wallpaper.nix.
// Check with: niri validate

input {
  keyboard {
    // Without this niri starts with NumLock off and the numpad types
    // navigation keys. See modules/hardware/numpad.nix.
    numlock
    xkb {
      layout "us"
    }
  }
  mouse {
    accel-profile "flat"
  }
  // Moving focus to the other monitor with the keyboard takes the pointer along.
  warp-mouse-to-focus
}

// waybar, swaybg and mako are started by systemd / D-Bus, not from here.
spawn-at-startup "lxqt-policykit-agent"

// Don't show the "Important Hotkeys" overlay at login (Mod+Shift+Slash
// still opens it).
hotkey-overlay {
  skip-at-startup
}

// Lets borders and shadows draw around windows instead of behind client-side
// decorations (which would also tint transparent windows).
prefer-no-csd

layout {
  // Mod+R cycles through these.
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
  default-column-width { proportion 0.5; }

  // A lone window is centred instead of sitting at the left edge; focusing a
  // column that doesn't fit next to the previous one centres it.
  always-center-single-column
  center-focused-column "on-overflow"

  background-color "transparent" // see the wallpaper layer-rule below

  // Focus is shown by the border colour only (width/colours in nix.kdl).
  focus-ring {
    off
  }

  // Soft drop shadow (niri's defaults: softness 30, spread 5, offset y=5).
  shadow {
    on
  }
}

// Frosted glass behind translucent surfaces (stylix opacity settings in
// modules/theme.nix). By default blur is "xray": it shows the blurred
// wallpaper only, computed once. That suits tiled windows and the bar.
// The launcher floats over windows, so it blurs what's really behind it.
// mako isn't blurred: niri blurs the whole layer surface, including the
// transparent gaps between stacked notifications.
blur {
  offset 2.5 // default 3.0; a little lighter so the wallpaper's texture shows
}
window-rule {
  match app-id=r#"^com\.mitchellh\.ghostty$"#
  match app-id="^vesktop$"
  background-effect {
    blur true
  }
}
layer-rule {
  match namespace="^waybar$"
  background-effect {
    blur true
  }
}
layer-rule {
  match namespace="^launcher$"
  background-effect {
    blur true
    xray false
  }
}

// Small utility windows float instead of taking a whole column. (Dialogs with
// a parent window already float by default.)
window-rule {
  match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
  match app-id="blueman-manager"
  match app-id="^lxqt-policykit"
  match app-id=r#"^com\.gabm\.satty$"#
  match app-id="^firefox$" title="^Picture-in-Picture$"
  open-floating true
}

// Put the wallpaper in the backdrop so it also shows in the overview (Mod+O).
// Workspaces paint an opaque background over the backdrop by default, so it
// is made transparent in the layout block above; the wallpaper then stays
// still instead of scrolling with workspaces.
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

output "HDMI-A-1" {
  position x=0 y=0
}
output "HDMI-A-2" {
  position x=1920 y=0
}

include "binds.kdl"
include "nix.kdl"
