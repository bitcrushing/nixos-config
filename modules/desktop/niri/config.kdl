// niri config. Keybindings are in binds.kdl. Colours, gaps, border width,
// cursor and anything needing a Nix store path are in nix.kdl, generated by
// modules/desktop/niri.nix. The wallpaper's native renderer and generated
// scene are configured in modules/desktop/wallpaper.nix.
// Check with: niri validate

input {
  keyboard {
    // Without this niri starts with NumLock off and the numpad types
    // navigation keys. See modules/hardware/numpad.nix.
    numlock
    xkb {
      layout "us"
    }
  }
  mouse {
    accel-profile "flat"
  }
  // Moving focus to the other monitor with the keyboard takes the pointer along.
  warp-mouse-to-focus
}

// Noctalia and the wallpaper have systemd user services; nothing else starts here.

// Don't show the "Important Hotkeys" overlay at login (Mod+Shift+Slash
// still opens it).
hotkey-overlay {
  skip-at-startup
}

// Lets borders and shadows draw around windows instead of behind client-side
// decorations (which would also tint transparent windows).
prefer-no-csd

layout {
  // Mod+R cycles through these.
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
  default-column-width { proportion 0.5; }

  // A lone window is centred instead of sitting at the left edge; focusing a
  // column that doesn't fit next to the previous one centres it.
  always-center-single-column
  center-focused-column "on-overflow"

  background-color "transparent" // see the wallpaper layer-rule below

  // Focus is shown by the border colour only (width/colours in nix.kdl).
  focus-ring {
    off
  }

  // Soft drop shadow (niri's defaults: softness 30, spread 5, offset y=5).
  shadow {
    on
  }
}

// Frosted glass behind translucent surfaces (stylix opacity settings in
// modules/theme.nix). By default blur is "xray": it shows the blurred
// wallpaper only. Animation can invalidate that cache, so its damage is kept
// to sparse details rather than full-frame water distortion.
blur {
  offset 2.5 // default 3.0; a little lighter so the wallpaper's texture shows
}
window-rule {
  match app-id=r#"^com\.mitchellh\.ghostty$"#
  match app-id="^vesktop$"
  background-effect {
    blur true
  }
}
// Noctalia publishes blur regions for its own surfaces; follow upstream and
// don't xray them, so the blur samples the real content behind instead of
// flashing wallpaper when panels map and unmap.
layer-rule {
  match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
  background-effect {
    blur true
    xray false
  }
}

// Small utility windows float instead of taking a whole column. (Dialogs with
// a parent window already float by default.)
window-rule {
  match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
  match app-id=r#"^com\.gabm\.satty$"#
  match app-id="^firefox$" title="^Picture-in-Picture$"
  open-floating true
}

// Noctalia's Settings window floats; notification actions may focus windows.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}
debug {
  honor-xdg-activation-with-invalid-serial
}

// The wallpaper sits in the backdrop so it also shows in
// the overview (Mod+O). Workspaces paint an opaque background over the
// backdrop by default, so it is made transparent in the layout block above;
// the landscape stays in place instead of scrolling with workspaces.
layer-rule {
  match namespace="^(twilight-wallpaper|noctalia-wallpaper)"
  place-within-backdrop true
}

output "HDMI-A-1" {
  position x=0 y=0
}
output "HDMI-A-2" {
  position x=1920 y=0
}

include "binds.kdl"
include "nix.kdl"
